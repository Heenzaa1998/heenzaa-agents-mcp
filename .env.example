APP_NAME=Next.js Drizzle Template
# Neon Postgres. On Vercel the Neon integration sets both; locally run
# `vercel env pull` or paste them from the Neon dashboard.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# KIE.ai API key for the image-generation MCP tools (server-side only).
# Get one at https://kie.ai/api-key
KIE_API_KEY=
# Shared static token that protects /api/mcp. When set, requests must send it as
# "Authorization: Bearer <token>" or "x-api-key: <token>". Leave empty for an
# authless server (local dev). In claude.ai, add it via the connector's header.
MCP_AUTH_TOKEN=
# Cloudflare R2 (private bucket) for storing generated media. Storage turns on
# only when all four are set; otherwise tools return the provider's temporary URLs.
# Create the keys in the dashboard: R2 > Manage API Tokens > Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
LOG_LEVEL=info
METRICS_PREFIX=nextjs_drizzle_
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=nextjs-drizzle
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACE_IGNORE_PATHS=/_next/*,/favicon.ico,/metrics
OTEL_TRACE_SAMPLE_RATIO=1
