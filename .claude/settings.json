{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(node_modules/.bin/tsc *)",
      "Bash(node_modules/.bin/eslint *)",
      "Bash(node_modules/.bin/vitest *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -qE \"\\\"(file_path|filePath)\\\": *\\\"[^\\\"]+\\.tsx?\\\"\" && [ -x node_modules/.bin/tsc ]; then node_modules/.bin/tsc --noEmit; fi",
            "timeout": 180,
            "statusMessage": "Typechecking..."
          }
        ]
      }
    ]
  }
}
