{
  "name": "nextjs-drizzle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm db:migrate && pnpm build && playwright test",
    "e2e:ui": "pnpm db:migrate && pnpm build && playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "observability:up": "docker compose -f docker-compose.observability.yml up -d",
    "observability:down": "docker compose -f docker-compose.observability.yml down -v",
    "observability:logs": "docker compose -f docker-compose.observability.yml logs -f tempo grafana",
    "observability:test": "pnpm observability:up && pnpm db:migrate && pnpm build && node ./scripts/observability-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.71.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.213.0",
    "@opentelemetry/resources": "2.6.0",
    "@opentelemetry/sdk-node": "0.213.0",
    "@opentelemetry/sdk-trace-base": "2.6.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@radix-ui/react-slot": "1.2.4",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.1",
    "lucide-react": "0.577.0",
    "mcp-handler": "^2.1.1",
    "next": "16.1.6",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@next/env": "16.1.6",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "0.31.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.1.6",
    "jsdom": "28.1.0",
    "pino-pretty": "13.1.3",
    "shadcn": "4.0.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
